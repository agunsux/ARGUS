# =============================================================================
# TIKUM & ARGUS Environment Configuration
# =============================================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=development

# Admin & Role Security (Required in production)
# Admin Control Center bootstrap: without ADMIN_PASSWORD the bootstrapped
# admin account has NO usable password (there is deliberately no default).
ADMIN_EMAIL=ops@tikum.app
ADMIN_PASSWORD=
ARGUS_ADMIN_PASSWORD=
ARGUS_SELLER_PASSWORD=
ARGUS_BUYER_PASSWORD=
ARGUS_BUYER2_PASSWORD=
ARGUS_PIC_PASSWORD=

# Transactional Email & Operational Inboxes (Resend Free Tier — Rp0/month)
# CRITICAL: SERVER-SIDE ONLY. Never expose to client-side bundles or frontend code.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="TIKUM <support@tikum.app>"
EMAIL_REPLY_TO=support@tikum.app
EMAIL_SUPPORT=support@tikum.app
EMAIL_ADMIN=admin@tikum.app
EMAIL_WEBHOOK_SECRET=

# Payment Gateway Architecture (Section 1, 2, 25)
# Primary: DOKU (Escrow & Hold & Release Settlement)
# Backup #1: Midtrans (Snap, Core API, Iris)
# Backup #2: Xendit (xenPlatform, Invoices, Disbursements)
# Legacy RCB: DELETED from production architecture
DEFAULT_PAYMENT_PROVIDER=doku
ENABLE_DOKU_PRODUCTION=false
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_API_BASE_URL=https://api-sandbox.doku.com
DOKU_WEBHOOK_SECRET=
DOKU_HOLD_RELEASE_ENABLED=false
DOKU_KYC_VERIFIED=false
DOKU_CONTRACT_VERIFIED=false

# Payment Gateway (Midtrans - Backup #1)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IRIS_ENABLED=false

# Payment Gateway (Xendit - Backup #2)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_XENPLATFORM_ENABLED=false


