{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "argus-trust-infrastructure.vercel.app"
        }
      ],
      "destination": "https://tikum.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "ARGUS_REAL_SOURCE_SEED": "true"
  },
  "crons": [
    {
      "path": "/api/discovery/lifecycle/cron",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/content/scheduler/cron",
      "schedule": "0 2 * * *"
    }
  ]
}
