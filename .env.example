# =============================================================================
# TIKUM & ARGUS Environment Configuration
# =============================================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=development

# Admin & Role Security (Required in production)
# Admin Control Center bootstrap: without ADMIN_PASSWORD the bootstrapped
# admin account has NO usable password (there is deliberately no default).
ADMIN_EMAIL=ops@tikum.app
ADMIN_PASSWORD=
ARGUS_ADMIN_PASSWORD=
ARGUS_SELLER_PASSWORD=
ARGUS_BUYER_PASSWORD=
ARGUS_BUYER2_PASSWORD=
ARGUS_PIC_PASSWORD=

# Transactional Email (Resend Free Tier — Zero-Cost First: Rp0/month)
# CRITICAL: SERVER-SIDE ONLY. Never expose to client-side bundles or frontend code.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="TIKUM <support@tikum.app>"
EMAIL_REPLY_TO=support@tikum.app
EMAIL_ADMIN=admin@tikum.app

# Payment Gateway (RCB - Primary MVP Provider)
# HARD PRODUCTION GATE: ENABLE_RCB_PRODUCTION must remain false until all 12 criteria pass
ENABLE_RCB_PRODUCTION=false
DEFAULT_PAYMENT_PROVIDER=rcb
RCB_API_BASE_URL=https://api-sandbox.rcb.id
RCB_API_KEY=
RCB_SECRET_KEY=
RCB_CLIENT_ID=
RCB_WEBHOOK_SECRET=

# Payment Gateway (iPaymu - Secondary / Fallback Provider)
IPAYMU_API_KEY=
IPAYMU_VA=
IPAYMU_WEBHOOK_URL=

